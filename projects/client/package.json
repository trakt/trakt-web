{
  "name": "client",
  "version": "0.0.1",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "pre:dev": "bun run i18n:web:watch",
    "dev": "concurrently 'bun run pre:dev' 'vite dev'",
    "dev:staging": "concurrently 'bun run pre:dev' 'cross-env IS_STAGING=true vite dev'",
    "dev:contrib": "concurrently 'bun run pre:dev' 'cross-env  IS_CONTRIB=true vite dev'",
    "dev:local": "concurrently 'bun run pre:dev' 'cross-env IS_LOCAL=true vite dev'",
    "prebuild": "bun run i18n:web",
    "build": "vite build",
    "prebuild:preview": "bun run prebuild",
    "build:preview": "IS_PREVIEW=true vite build",
    "build:doctor": "IS_DOCTOR=true vite build --mode doctor",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --incremental",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "pretest:unit": "bun run prebuild",
    "test:unit": "vitest",
    "test:doctor": "vitest --run --reporter=dot",
    "pretest:cov": "bun run prebuild",
    "test:cov": "vitest --coverage",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-transform-types cucumber-js -c ./cucumber.mjs",
    "i18n:web": "bun run i18n:generate ./i18n --platforms web",
    "i18n:web:watch": "bun run i18n:generate:watch ./i18n --platforms web",
    "i18n:compile": "paraglide-js compile --project ./i18n/project.inlang --outdir ./src/lib/paraglide",
    "i18n:compile:base": "bun .scripts/prepare-base-i18n.ts && paraglide-js compile --project ./node_modules/base-i18n/project.inlang --outdir ./src/lib/paraglide",
    "i18n:prepare": "bun run i18n:web && bun run i18n:compile",
    "sync:immutable": "bun .scripts/sync-immutable-to-r2.ts",
    "prune:immutable": "bun .scripts/prune-immutable-r2.ts",
    "prune:share-images": "svelte-kit sync && bun .scripts/prune-share-images.run.ts",
    "i18n:resolve": "bun .scripts/resolve-i18n.ts",
    "i18n:check": "bun .scripts/check-i18n-placeholders.ts",
    "pwa:screenshots": "bun .scripts/capture-pwa-screenshots.ts",
    "i18n:generate": "svelte-kit sync && bun i18n/generator/cli.ts -i i18n/meta/ -o i18n/",
    "i18n:generate:watch": "svelte-kit sync && bun i18n/generator/cli.ts -i i18n/meta/ -o i18n/ --watch"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261121.1",
    "@cucumber/cucumber": "13.3.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/adapter-cloudflare": "7.2.10",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.13",
    "@types/d3": "7.4.3",
    "@types/eslint": "9.6.1",
    "@types/serviceworker": "0.0.210",
    "@typescript/native": "npm:typescript@7.1.0-dev.20261121.1",
    "@vite-pwa/sveltekit": "1.1.0",
    "@vitest/coverage-istanbul": "4.1.12",
    "concurrently": "10.0.7",
    "cross-env": "10.1.0",
    "@types/papaparse": "5.5.2",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "msw": "2.15.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "sass-embedded": "1.108.2",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@inlang/paraglide-js": "2.29.3",
    "@libn/fuzzy": "npm:@jsr/libn__fuzzy@0.4.0",
    "@sentry/sveltekit": "10.78.0",
    "@svelte-put/shortcut": "4.2.1",
    "@sveltejs/kit": "2.70.4",
    "@takumi-rs/helpers": "2.22.1",
    "@takumi-rs/wasm": "2.22.1",
    "@tanstack/query-core": "5.108.2",
    "@tanstack/query-devtools": "5.108.2",
    "@tanstack/query-persist-client-core": "5.108.2",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-placeholder": "3.35.0",
    "@tiptap/markdown": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@tiptap/suggestion": "3.35.0",
    "@trakt/api": "npm:@jsr/trakt__api@0.8.1",
    "@ts-rest/core": "3.52.1",
    "@use-gesture/vanilla": "10.3.1",
    "bits-ui": "2.22.0",
    "d3": "7.9.2",
    "date-fns": "4.4.0",
    "fflate": "0.8.3",
    "idb-keyval": "6.3.0",
    "marked": "18.2.1",
    "oidc-client-ts": "3.5.0",
    "papaparse": "5.7.1",
    "plyr": "3.8.4",
    "resolve-accept-language": "3.2.2",
    "rxjs": "7.8.2",
    "svelte": "5.59.1",
    "svelte-confetti": "2.3.2",
    "ts-retry": "7.0.3",
    "typesense": "3.2.0",
    "unwasm": "0.6.3",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  }
}
