{
  "name": "client",
  "version": "0.0.1",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "pre:dev": "bun run i18n:web:watch",
    "dev": "concurrently 'bun run pre:dev' 'vite dev'",
    "dev:staging": "concurrently 'bun run pre:dev' 'cross-env IS_STAGING=true vite dev'",
    "dev:contrib": "concurrently 'bun run pre:dev' 'cross-env  IS_CONTRIB=true vite dev'",
    "dev:local": "concurrently 'bun run pre:dev' 'cross-env IS_LOCAL=true vite dev'",
    "prebuild": "bun run i18n:web",
    "build": "vite build",
    "prebuild:preview": "bun run prebuild",
    "build:preview": "IS_PREVIEW=true vite build",
    "build:doctor": "IS_DOCTOR=true vite build --mode doctor",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "pretest:unit": "bun run prebuild",
    "test:unit": "vitest",
    "test:doctor": "vitest --run --reporter=dot",
    "pretest:cov": "bun run prebuild",
    "test:cov": "vitest --coverage",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-transform-types cucumber-js -c ./cucumber.mjs",
    "i18n:web": "bun run i18n:generate ./i18n --platforms web",
    "i18n:web:watch": "bun run i18n:generate:watch ./i18n --platforms web",
    "i18n:compile": "paraglide-js compile --project ./i18n/project.inlang --outdir ./src/lib/paraglide",
    "i18n:prepare": "bun run i18n:web && bun run i18n:compile",
    "sync:immutable": "bun .scripts/sync-immutable-to-r2.ts",
    "prune:immutable": "bun .scripts/prune-immutable-r2.ts",
    "prune:share-images": "svelte-kit sync && bun .scripts/prune-share-images.run.ts",
    "i18n:resolve": "bun .scripts/resolve-i18n.ts",
    "i18n:check": "bun .scripts/check-i18n-placeholders.ts",
    "pwa:screenshots": "bun .scripts/capture-pwa-screenshots.ts",
    "i18n:generate": "svelte-kit sync && bun i18n/generator/cli.ts -i i18n/meta/ -o i18n/",
    "i18n:generate:watch": "svelte-kit sync && bun i18n/generator/cli.ts -i i18n/meta/ -o i18n/ --watch"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@cucumber/cucumber": "13.3.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.8",
    "@types/d3": "7.4.3",
    "@types/eslint": "9.6.1",
    "@types/serviceworker": "0.0.203",
    "@vite-pwa/sveltekit": "1.1.0",
    "@vitest/coverage-istanbul": "4.1.12",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "@types/papaparse": "5.5.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "2.15.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "sass-embedded": "1.106.1",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@inlang/paraglide-js": "2.29.1",
    "@libn/fuzzy": "npm:@jsr/libn__fuzzy@0.4.0",
    "@sentry/sveltekit": "10.76.2",
    "@svelte-put/shortcut": "4.2.0",
    "@sveltejs/kit": "2.70.3",
    "@takumi-rs/helpers": "2.18.1",
    "@takumi-rs/wasm": "2.18.1",
    "@tanstack/query-core": "5.104.5",
    "@tanstack/query-devtools": "5.104.5",
    "@tanstack/query-persist-client-core": "5.104.5",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@trakt/api": "npm:@jsr/trakt__api@0.7.14",
    "@ts-rest/core": "3.52.1",
    "@use-gesture/vanilla": "10.3.1",
    "bits-ui": "2.20.2",
    "d3": "7.9.0",
    "date-fns": "4.4.0",
    "fflate": "0.8.3",
    "idb-keyval": "6.3.0",
    "marked": "18.1.1",
    "oidc-client-ts": "3.5.0",
    "papaparse": "5.7.0",
    "plyr": "3.8.4",
    "resolve-accept-language": "3.2.2",
    "rxjs": "7.8.2",
    "svelte": "5.57.2",
    "svelte-confetti": "2.3.2",
    "ts-retry": "7.0.3",
    "typesense": "3.2.0",
    "unwasm": "0.6.2",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  }
}
